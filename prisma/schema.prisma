generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model acciofar {
  codigo      Int?
  descripcion String? @db.VarChar(255)

  @@index([codigo], map: "codigo")
  @@ignore
}

model acuerdo {
  rowid      Int       @id @default(autoincrement())
  farmacia   Int       @default(0)
  fecha      DateTime? @db.Date
  debe       Decimal?  @default(0.00) @db.Decimal(9, 2)
  haber      Decimal?  @default(0.00) @db.Decimal(9, 2)
  observac   String?   @default("") @db.VarChar(45)
  usuario    Int?
  cuotas     Int?      @default(0)
  anulado    Int?      @default(0) @db.TinyInt
  suspendido Int?      @default(0) @db.TinyInt
  importe    Decimal   @db.Decimal(10, 2)
  desde      DateTime  @db.Date
  hasta      DateTime  @db.Date
  afiliados  Int?
  sentencia  Int?
  inspector  Int?

  @@index([desde], map: "desde")
  @@index([hasta], map: "hasta")
}

model acuerdo_afiliado {
  rowid    Int  @id @default(autoincrement())
  acuerdo  Int
  afiliado Int
  activado Int?
}

