# Base de datos MySQL (misma que osadef-api)
DATABASE_URL="mysql://USUARIO:PASSWORD@HOST:3306/NOMBRE_DB"

# API Key para n8n (DEBE ser distinta a API_KEY_N8N de prestadores)
API_KEY_N8N_ASESORES="cambiar-por-una-clave-segura-y-distinta"

# Multi-key (src/config/env.ts, src/middleware/auth-guard.ts): un consumidor
# nuevo = una variable API_KEY_ASESORES_<ETIQUETA> más, cero cambios de
# código. Generar con `openssl rand -hex 32`, compartir por un canal
# seguro (nunca chat/email en texto plano). Ver AGENTS.md "Auth — multi-key".
# API_KEY_ASESORES_WIDGET_CHAT="cambiar-por-una-clave-segura-y-distinta"

# Puerto del servidor
PORT=3003

# Entorno
NODE_ENV=development
